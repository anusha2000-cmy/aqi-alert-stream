# Poll every N seconds (supports decimals, e.g. 30 or 5.5)
POLL_INTERVAL_SECONDS=300
DEBUG=false

# Optional — only needed for providers that require authentication
# AQI_API_KEY=
# AQI_API_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality
# GEOCODING_API_BASE_URL=https://geocoding-api.open-meteo.com/v1/search
# AQI_REQUEST_TIMEOUT_SECONDS=10
